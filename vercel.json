{
  "version": 2,
  "regions": ["icn1"],
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "app/client/api/_lib/pdf/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
