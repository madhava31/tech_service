# Local dev: leave unset — Vite proxies /api to http://localhost:4000 (see vite.config.ts).
# Production (Vercel): leave unset too. Frontend and API are served from the same Vercel
# deployment/domain, so the default '/api' base URL (see src/api.ts) already resolves correctly.
# Only set this if the API is ever split out to a separate domain.
VITE_API_URL=

# Server-side only (never exposed to the frontend bundle).
# AI Assistant (POST /api/ai/ask): You can use Claude or Gemini.
# For Claude (Recommended): set ANTHROPIC_API_KEY (from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-3-5-haiku-20241022 (fast & cost-effective) or claude-3-5-sonnet-20241022
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Alternatively, for Gemini:
GEMINI_API_KEY=

# Server-side only. Required to run the API at all — local dev (app/api/local-dev.js reads this
# file directly) and in Vercel production (set as a project Environment Variable there instead).
# Postgres connection string. For Supabase, use the "Transaction pooler" connection string
# (port 6543) from Project Settings > Database > Connection string.
DATABASE_URL=
